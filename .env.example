# Приложение
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# Events Provider API
EVENTS_PROVIDER_BASE_URL=http://events-provider.dev-2.python-labs.ru
EVENTS_PROVIDER_API_KEY=change-me

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/events_aggregator

# Синхронизация
SYNC_INTERVAL_SECONDS=86400